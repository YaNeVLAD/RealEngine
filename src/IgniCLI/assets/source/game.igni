package program;

import engine.*;

class Player(val entity: engine.Entity) {
    var speed: Double = 150.0;
}

var player: Player? = null;

fun onGameStart() {
    val playerEntity = engine.spawn("PlayerPrefab", Vector2(0.0, 0.0));
    player = Player(playerEntity);

    engine.spawn("EnemyPrefab", Vector2(4.0, 3.0));
}

fun onUpdate(deltaTime: Double, time: Double) {
    if (player == null) {
        return;
    }

    val p = player as Player;

    val moveX = engine.getAxis("Horizontal");
    val moveY = engine.getAxis("Vertical");

    if (moveX != 0.0 || moveY != 0.0) {
        val direction = Vector2(moveX, moveY);
        p.entity.applyImpulse(direction, p.speed * deltaTime);
    }
}