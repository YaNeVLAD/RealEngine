package global;

annotation class DotNetMethod(val signature: String);

annotation class DotNetBaseClass(val signature: String);

annotation class DotNetOpcode(val operation: String);

@DotNetMethod("void [mscorlib]System.Console::WriteLine(int64)")
external fun println(value: Int): Unit;

@DotNetMethod("void [mscorlib]System.Console::WriteLine(float64)")
external fun println(value: Double): Unit;

@DotNetMethod("void [mscorlib]System.Console::WriteLine(string)")
external fun println(value: String): Unit;

@DotNetMethod("void [mscorlib]System.Console::WriteLine(bool)")
external fun println(value: Bool): Unit;

external class <T> Array {

    @DotNetOpcode("ldlen")
    external fun size(): Int;

    @DotNetOpcode("ldelem")
    external fun get(index: Int): T;

    @DotNetOpcode("stelem")
    external fun set(index: Int, value: T): Unit;

}

@DotNetOpcode("newarr")
external fun <T> makeArray(size: Int): Array<T>;

fun <T> arrayOf(elements: T...): Array<T> {
	val size = elements.size();
	val result = makeArray::<T>(size);
	for (i in 0..size - 1) {
		result[i] = elements[i];
	}

	return result;
}

external class Type {
    external fun hasAnnotation(annoName: String): Bool;
    external fun hasFieldAnnotation(fieldName: String, annoName: String): Bool;
    external fun hasMethodAnnotation(methodName: String, annoName: String): Bool;
}

external fun typeof(obj: Any): Type;